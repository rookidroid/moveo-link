{
  "name": "moveo-link",
  "productName": "Moveo Link",
  "version": "0.1.0",
  "description": "Desktop controller for the Moveo robot arm over WiFi",
  "author": "rookidroid",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "mock": "tsx scripts/mock-robot.ts",
    "web": "vite --config vite.web.config.ts",
    "diagrams": "electron scripts/joint-diagrams/render.mjs",
    "icons": "electron scripts/icons.mjs",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.3"
  }
}
